## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Azure Functions localsettings file
local.settings.json

# Environment configuration
.env
.env.*
!.env.example

# Local-only secrets (never commit)

# Machine-specific hardware profile for the model finder (gitignored by design)
**/hardware_override.yaml


# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

