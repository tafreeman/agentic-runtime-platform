# API Keys for LLM providers
# Copy this file to .env and fill in your keys
# The .env file is gitignored and will not be committed


# GitHub Models API (free tier available)
# Get your GitHub token: https://github.com/settings/tokens
GITHUB_TOKEN=


# OpenAI API (paid)
# Get your OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# Azure AI Foundry / Azure OpenAI (enterprise)
# Get your Azure OpenAI key: https://portal.azure.com/#view/Microsoft_Azure_ProjectOxford/CognitiveServicesHub/~/Keys
 # If you see keys with _0 through _n, these are backup keys. Use the next one if the first hits its rate limit.
AZURE_OPENAI_API_KEY_0=
AZURE_OPENAI_ENDPOINT_0=

# Azure AI Services endpoints (optional)
# Get your Azure AI Services endpoint: https://portal.azure.com/#view/Microsoft_Azure_ProjectOxford/CognitiveServicesHub/~/Keys
AZURE_AI_SERVICES_ENDPOINT=
AZURE_COGNITIVE_ENDPOINT=


# Gemini API (remote)
# Get your Gemini API key: https://aistudio.google.com/app/apikey
 # Gemini Model Rate Limits (reference)
 # Gemini 2.5 Flash Lite:        RPM 10   | TPM 250K   | RPD 20
 # Gemini 2.5 Flash TTS:        RPM 3    | TPM 10K    | RPD 10
 # Gemini 2.5 Flash:            RPM 5    | TPM 250K   | RPD 20
 # Gemini 3 Flash:              RPM 5    | TPM 250K   | RPD 20
 # Gemini Robotics ER 1.5:      RPM 10   | TPM 250K   | RPD 20
 # Gemma 3 12B:                 RPM 30   | TPM 15K    | RPD 14.4K
 # Gemma 3 1B:                  RPM 30   | TPM 15K    | RPD 14.4K
 # Gemma 3 27B:                 RPM 30   | TPM 15K    | RPD 14.4K
 # Gemma 3 2B:                  RPM 30   | TPM 15K    | RPD 14.4K
 # Gemma 3 4B:                  RPM 30   | TPM 15K    | RPD 14.4K
 # Gemini Embedding 1:          RPM 100  | TPM 30K    | RPD 1K
 # Gemini 2.5 Flash Native Audio Dialog: RPM Unlimited | TPM 1M | RPD Unlimited
GEMINI_API_KEY=

# Anthropic Claude (paid)
# Get your Anthropic API key: https://console.anthropic.com/settings/keys
 # Anthropic Model Rate Limits (reference)
 # Model:                RPM  | Input TPM | Output TPM | Context Limit
 # Claude Opus 4/4.1/4.5: 5   | 10K       | 4K         | ≤ 200k
 # Claude Haiku 4.x:      5   | 10K       | 4K         | ≤ 200k
 # Claude Sonnet 4/4.5:   5   | 10K       | 4K         | ≤ 200k
 # Claude Sonnet 3.7:     5   | 10K       | 4K         | ≤ 200k
 # Claude Haiku 3.5:      5   | 25K       | 5K         | ≤ 200k
 # Claude Haiku 3:        5   | 25K       | 5K         | ≤ 200k
 # Batch requests: 5/min across all models
 # Web search tool: 30/sec across all models
 # Files API storage: 100 GB/org
ANTHROPIC_API_KEY=


# Local model path (optional - auto-detected from ~/.cache/aigallery)
LOCAL_MODEL_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# Local model servers & discovery (model-router "rescan" probe — ADR-037/038)
# These feed the live model probe so the console lists what is actually
# runnable now. The backend reads them at process start, so RESTART the backend
# after editing — clicking "rescan" alone re-probes servers, not env vars.
# ─────────────────────────────────────────────────────────────────────────────

# Ollama local server base URL. Default: http://localhost:11434
OLLAMA_BASE_URL=
# Ollama hosted-cloud API key. When set, the cloud catalog (ollama.com) is also
# listed and proxied cloud models are tagged. Never logged.
OLLAMA_API_KEY=

# LM Studio server host (the OpenAI-compatible + native /api/v0 server).
# Leave unset to auto-probe http://127.0.0.1:1234 (LM Studio default) then
# :12340; the first reachable wins. Set explicitly to pin a non-standard port,
# e.g. LMSTUDIO_HOST=http://127.0.0.1:1234
LMSTUDIO_HOST=

# ONNX (onnxruntime-genai) model root(s) for the onnx:/local: backend.
# Default when unset: ~/.cache/aigallery (AI Dev Gallery cache). List multiple
# roots separated by the OS path separator (';' on Windows, ':' on POSIX) to
# also surface .aitk / .foundry caches — the aigallery default is always
# included. Discovery and the backend resolve the SAME roots, so every
# discovered onnx:<folder> is loadable.
# Example (Windows): ONNX_MODEL_DIR=~/.aitk/models/Microsoft;~/.foundry/cache/models/Microsoft
ONNX_MODEL_DIR=
AIGALLERY_CACHE=

# Windows AI (Phi Silica) - optional LAF Token Configuration
# Get your Phi Silica LAF token: https://www.phi-silica.com/ (see documentation for details)
PHI_SILICA_LAF_FEATURE_ID=
PHI_SILICA_LAF_TOKEN=
PHI_SILICA_LAF_ATTESTATION=


# ─────────────────────────────────────────────────────────────────────────────
# Tracing / OpenTelemetry (agentic-workflows-v2)
# ─────────────────────────────────────────────────────────────────────────────

# Enable OpenTelemetry tracing (opt-in). Set to 1 to enable, unset or 0 to disable.
AGENTIC_TRACING=

# Include sensitive content (prompts, outputs, tool args) in traces. Default: excluded.
# Set to 1 to include sensitive data in spans.
AGENTIC_TRACE_SENSITIVE=

# OTLP exporter endpoint. Default: http://localhost:4317 (AI Toolkit collector).
# For HTTP instead of gRPC, use http://localhost:4318/v1/traces with OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTLP protocol. Options: grpc (default), http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=


# ─────────────────────────────────────────────────────────────────────────────
# Runtime / Local Development (agentic-workflows-v2)
# ─────────────────────────────────────────────────────────────────────────────

# Optional API key required by the FastAPI auth middleware when set.
AGENTIC_API_KEY=

# Optional OIDC JWT authentication for /api/* routes. When enabled, clients
# can send Authorization: Bearer <JWT>. AGENTIC_API_KEY remains a fallback.
AGENTIC_OIDC_ENABLED=0
AGENTIC_OIDC_ISSUER=
AGENTIC_OIDC_AUDIENCE=
AGENTIC_OIDC_JWKS_URL=
AGENTIC_OIDC_ALGORITHMS=RS256
AGENTIC_OIDC_JWKS_CACHE_SECONDS=300
AGENTIC_OIDC_JWKS_TIMEOUT_SECONDS=5
AGENTIC_OIDC_LEEWAY_SECONDS=60

# Comma-separated CORS origins. Leave empty for local defaults.
AGENTIC_CORS_ORIGINS=

# Set to 1 to use deterministic placeholder models without provider API calls.
AGENTIC_NO_LLM=0

# Optional directory for externally managed agent definitions.
AGENTIC_EXTERNAL_AGENTS_DIR=

# Shell executable used by shell-enabled workflows.
SHELL=/bin/bash

# Set to 1 to block tool access to private IP ranges.
AGENTIC_BLOCK_PRIVATE_IPS=0

# Optional path for persistent agent memory storage.
AGENTIC_MEMORY_PATH=


# ─────────────────────────────────────────────────────────────────────────────
# Security / Path Containment (agentic-workflows-v2)
# ─────────────────────────────────────────────────────────────────────────────

# Base directory for all file operations. When set, file access is constrained
# to this directory tree, preventing path traversal attacks. Operators MUST
# configure this before using any file tools — leaving it unset causes all file
# operations to fail closed with a clear error.
# Example: AGENTIC_FILE_BASE_DIR=/app/data
AGENTIC_FILE_BASE_DIR=

# Comma-separated list of shell command names permitted by ShellTool. When unset
# or empty, ALL shell commands are disabled (fail-closed). Only list programs that
# agents genuinely need. Full paths are resolved to their basename for comparison.
# Example: AGENTIC_SHELL_ALLOWED_COMMANDS=ls,cat,python,git
AGENTIC_SHELL_ALLOWED_COMMANDS=

# Sanitization middleware fail-open override (NOT recommended for production).
# Default (unset / any value other than "1"): fail-closed — requests are rejected
# with HTTP 503 when the sanitization layer is unavailable.
# Set to exactly "1" to pass requests through unsanitized when the sanitizer
# is not initialised (legacy behaviour, use only for debugging).
# BREAKING CHANGE (2026-05-09): previously accepted "true" and "yes"; now
# only "1" is recognised. Update any deployment scripts that used those values.
AGENTIC_SANITIZER_FAIL_OPEN=


# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting / Auth Throttle (agentic-workflows-v2)
# ─────────────────────────────────────────────────────────────────────────────

# Engine adapter selected at server startup. The FastAPI lifespan eagerly
# validates that the selected adapter's extras are installed and raises
# ConfigurationError with an install hint on failure. Set to "native" to
# bypass the LangChain extras-installed gate.
AGENTIC_DEFAULT_ADAPTER=langchain

# Global per-IP rate limit applied by slowapi middleware. Public endpoints
# (/api/health, /docs, /openapi.json, /redoc) are exempt. Format: "<n>/<period>".
AGENTIC_RATE_LIMIT_DEFAULT=60/minute

# Set to "1" to disable the global rate-limit middleware entirely.
# Intended for tests; do not set in production.
AGENTIC_RATE_LIMIT_DISABLED=

# Sliding window (seconds) over which 401 auth failures are counted per
# client IP for brute-force protection.
AGENTIC_AUTH_LOCKOUT_WINDOW_SECONDS=60

# Consecutive 401 failures within AGENTIC_AUTH_LOCKOUT_WINDOW_SECONDS
# before the IP is locked out.
AGENTIC_AUTH_LOCKOUT_THRESHOLD=5

# Lockout duration (seconds). Locked IPs receive HTTP 429 with a
# Retry-After header until the lockout expires. State is in-process; a
# Redis-backed cluster-wide implementation is planned for Sprint 2.
AGENTIC_AUTH_LOCKOUT_DURATION_SECONDS=300
