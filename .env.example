# Agentic Runtime Platform environment template
#
# Copy this file to .env and set only the values your deployment uses.
# .env is ignored by Git. Never commit credentials.


# -----------------------------------------------------------------------------
# Chat model providers
# -----------------------------------------------------------------------------

# GitHub Models
GITHUB_TOKEN=
# GH_TOKEN=

# OpenAI or an OpenAI-compatible endpoint
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# NVIDIA NIM. NVIDIA_BASE_URL supports a self-hosted endpoint.
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=
# NIM reasoning models spend their token budget on an internal chain-of-thought
# phase and can return empty content, so requests disable it by default. Set to
# 0/false/no/off only for a self-hosted NIM whose chat template rejects the
# chat_template_kwargs field.
# NVIDIA_DISABLE_THINKING=1

# OpenRouter
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=

# Azure OpenAI. The base runtime uses the unnumbered values.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

# Repository model-inventory tools also support matching numbered slots.
# AZURE_OPENAI_API_KEY_0=
# AZURE_OPENAI_ENDPOINT_0=
# AZURE_OPENAI_DEPLOYMENT_0=

# Azure AI Foundry. Some inventory tools also inspect
# AZURE_FOUNDRY_ENDPOINT_<model-or-slot>.
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
# AZURE_FOUNDRY_ENDPOINT_1=

# Optional Azure multi-service endpoints used by repository tools.
AZURE_AI_SERVICES_ENDPOINT=
AZURE_COGNITIVE_ENDPOINT=


# -----------------------------------------------------------------------------
# Local model servers and discovery
# -----------------------------------------------------------------------------

# Runtime Ollama backend and discovery.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Root model-inventory and benchmark tools use OLLAMA_HOST.
# Set it to the same endpoint when using those tools.
OLLAMA_HOST=http://localhost:11434

# LM Studio. When unset, discovery probes its normal local ports.
LMSTUDIO_HOST=
LM_API_TOKEN=

# ONNX model discovery roots. Separate multiple paths with the operating
# system path separator: semicolon on Windows, colon on POSIX.
LOCAL_MODEL_PATH=
ONNX_MODEL_DIR=
AIGALLERY_CACHE=

# Optional Windows AI / Phi Silica values.
PHI_SILICA_LAF_FEATURE_ID=
PHI_SILICA_LAF_TOKEN=
PHI_SILICA_LAF_ATTESTATION=


# -----------------------------------------------------------------------------
# RAG embeddings
# -----------------------------------------------------------------------------

# provider="openai" reuses OPENAI_API_KEY above.
# provider="voyage" reads this value.
VOYAGE_API_KEY=


# -----------------------------------------------------------------------------
# Execution and model-call behavior
# -----------------------------------------------------------------------------

# Named YAML workflows default to the LangGraph adapter.
AGENTIC_DEFAULT_ADAPTER=langchain

# Replace model calls with a fixed response. Useful for flow tests only.
AGENTIC_NO_LLM=0

# Positive process-wide token cap on the shared native client.
# Blank, zero, negative, or invalid values mean no cap.
AGENTIC_TOKEN_BUDGET=

# ExecutionKit-backed provider path. Set to 0 for the legacy path.
AGENTIC_EK_PROVIDER=1

# Optional model override per capability tier.
# AGENTIC_MODEL_TIER_1=
# AGENTIC_MODEL_TIER_2=
# AGENTIC_MODEL_TIER_3=
# AGENTIC_MODEL_TIER_4=

# Additional agent-definition directory.
AGENTIC_EXTERNAL_AGENTS_DIR=

# Shell executable used by shell-enabled paths.
SHELL=/bin/bash


# -----------------------------------------------------------------------------
# Tool approval and agent-loop safety
# -----------------------------------------------------------------------------

# Require approval for every tool call.
AGENTIC_REQUIRE_TOOL_APPROVAL=0

# Extra comma-separated tool names that require approval.
AGENTIC_APPROVAL_REQUIRED_TOOLS=

# Approval wait limit in seconds. Zero or negative waits indefinitely.
AGENTIC_APPROVAL_TIMEOUT_SECONDS=1800

# Sanitize model input and output inside the shared agent loop.
AGENTIC_SANITIZE_AGENT_LOOP=1


# -----------------------------------------------------------------------------
# HTTP authentication and OIDC
# -----------------------------------------------------------------------------

# Static API key. When unset, protected API routes are open.
AGENTIC_API_KEY=

# OIDC requires issuer, audience, and JWKS URL. AGENTIC_API_KEY remains a
# fallback when both are configured.
AGENTIC_OIDC_ENABLED=0
AGENTIC_OIDC_ISSUER=
AGENTIC_OIDC_AUDIENCE=
AGENTIC_OIDC_JWKS_URL=
AGENTIC_OIDC_ALGORITHMS=RS256
AGENTIC_OIDC_JWKS_CACHE_SECONDS=300
AGENTIC_OIDC_JWKS_TIMEOUT_SECONDS=5
AGENTIC_OIDC_LEEWAY_SECONDS=60

# Comma-separated browser origins. Blank uses local development origins.
AGENTIC_CORS_ORIGINS=


# -----------------------------------------------------------------------------
# Rate limiting and authentication lockout
# -----------------------------------------------------------------------------

AGENTIC_RATE_LIMIT_DEFAULT=60/minute

# Exact value 1 disables rate limiting. Use only for tests.
AGENTIC_RATE_LIMIT_DISABLED=

AGENTIC_AUTH_LOCKOUT_WINDOW_SECONDS=60
AGENTIC_AUTH_LOCKOUT_THRESHOLD=5
AGENTIC_AUTH_LOCKOUT_DURATION_SECONDS=300


# -----------------------------------------------------------------------------
# File, shell, HTTP, and MCP boundaries
# -----------------------------------------------------------------------------

# File and git tools fail closed when this root is unset.
# AGENTIC_FILE_BASE_DIR=/app/data
AGENTIC_FILE_BASE_DIR=

# Shell tools deny every command when this list is empty.
# AGENTIC_SHELL_ALLOWED_COMMANDS=ls,cat,python,git
AGENTIC_SHELL_ALLOWED_COMMANDS=

# Block private, loopback, link-local, and reserved HTTP targets.
AGENTIC_BLOCK_PRIVATE_IPS=1

# Optional persistent path for the built-in memory tool.
AGENTIC_MEMORY_PATH=

# Optional MCP output token cap.
MAX_MCP_OUTPUT_TOKENS=

# Exact value 1 passes requests when sanitization is unavailable.
# Leave unset or 0 for fail-closed behavior.
AGENTIC_SANITIZER_FAIL_OPEN=


# -----------------------------------------------------------------------------
# Tracing, metrics, and logging
# -----------------------------------------------------------------------------

AGENTIC_TRACING=0
AGENTIC_METRICS=0

# Include prompts, outputs, tool arguments, and retrieval text in spans.
# Leave off unless the trace backend is approved for that data.
AGENTIC_TRACE_SENSITIVE=0

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=agentic-workflows-v2

# text or json
LOG_FORMAT=text


# -----------------------------------------------------------------------------
# Audit records
# -----------------------------------------------------------------------------

AUDIT_LOG_ENABLED=0
AUDIT_LOG_BACKEND=file
AUDIT_LOG_FILE_PATH=.agentic_audit.jsonl
AUDIT_LOG_REDIS_STREAM=agentic:audit
AUDIT_LOG_MAX_EVENTS=10000


# -----------------------------------------------------------------------------
# Redis and replay storage
# -----------------------------------------------------------------------------

REDIS_URL=
REDIS_CIRCUIT_BREAKER_PREFIX=agentic:cb:
REDIS_CIRCUIT_BREAKER_TTL=3600

# auto, redis, sqlite, or memory
REPLAY_STORE_BACKEND=auto
REPLAY_STORE_TTL=14400
REPLAY_STORE_MAX_EVENTS=500

# Blank uses <repository>/.agentic_replay.db.
REPLAY_SQLITE_PATH=
REPLAY_STORE_RETENTION_SECONDS=3600


# -----------------------------------------------------------------------------
# LangGraph checkpointing
# -----------------------------------------------------------------------------

# PostgreSQL URL. Requires the agentic-workflows-v2 postgres extra.
AGENTIC_CHECKPOINTER_URL=


# -----------------------------------------------------------------------------
# Optional strict model verification
# -----------------------------------------------------------------------------

AGENTIC_REGISTRY_STRICT=0
AGENTIC_STRICT_MODEL_VERIFY=0
AGENTIC_TRUSTED_MODEL_HASHES=
