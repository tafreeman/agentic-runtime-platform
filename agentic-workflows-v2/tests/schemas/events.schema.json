    "TokenDeltaEvent": {
      "description": "Incremental text delta streamed from an LLM completion.\n\nEmitted per chunk while the EK adapter streams a step's response. Carries\nthe same correlation fields as the sibling step events (``run_id``,\n``step``, ``timestamp``) plus the ``delta`` text fragment. After the stream\nis exhausted the caller emits a ``step_complete`` with the assembled text.",
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
