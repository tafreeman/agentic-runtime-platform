{
  "$defs": {
    "ChatImagePart": {
      "description": "A request-local raster image sent to a vision-capable model.",
      "properties": {
        "detail": {
          "default": "auto",
          "enum": [
            "auto",
            "low",
            "high"
          ],
          "title": "Detail",
          "type": "string"
        },
        "type": {
          "const": "image_url",
          "default": "image_url",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "maxLength": 7100000,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ChatImagePart",
      "type": "object"
    },
    "ChatMessage": {
      "description": "One conversation turn submitted to the chat playground.\n\n``content`` is capped well above any real chat turn so a single request\ncannot buffer unbounded memory through the sanitization middleware.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "image_url": "#/$defs/ChatImagePart",
                    "text": "#/$defs/ChatTextPart"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/ChatTextPart"
                  },
                  {
                    "$ref": "#/$defs/ChatImagePart"
                  }
                ]
              },
              "maxItems": 12,
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Plain text or provider-neutral text/image content blocks",
          "title": "Content"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "ChatTextPart": {
      "description": "Text content inside a multimodal conversation turn.",
      "properties": {
        "text": {
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ChatTextPart",
      "type": "object"
    },
    "ModelChatRequest": {
      "additionalProperties": false,
      "description": "Direct-model constructor for ``POST /api/chat``.",
      "properties": {
        "messages": {
          "description": "Conversation history, oldest first",
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "model": {
          "description": "Full prefixed model id to chat with directly",
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "temperature": {
          "default": 0.2,
          "description": "Sampling temperature",
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "messages",
        "model"
      ],
      "title": "ModelChatRequest",
      "type": "object"
    },
    "TierChatRequest": {
      "additionalProperties": false,
      "description": "Tier-routed constructor for ``POST /api/chat``.",
      "properties": {
        "messages": {
          "description": "Conversation history, oldest first",
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "temperature": {
          "default": 0.2,
          "description": "Sampling temperature",
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "tier": {
          "description": "Capability tier to resolve through the model router (1-5)",
          "maximum": 5,
          "minimum": 1,
          "title": "Tier",
          "type": "integer"
        }
      },
      "required": [
        "messages",
        "tier"
      ],
      "title": "TierChatRequest",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ModelChatRequest"
    },
    {
      "$ref": "#/$defs/TierChatRequest"
    }
  ],
  "description": "Overloaded request body for ``POST /api/chat``.\n\nExactly one routing constructor is accepted:\n\n* ``for_model`` / ``model`` builds one FULL prefixed model id directly;\n* ``for_tier`` / ``tier`` resolves the configured tier and fallback chain.\n\nHTTP clients use the equivalent JSON union by sending either ``model`` or\n``tier``. Supplying both or neither is rejected by the two strict variants.",
  "title": "ChatRequest"
}
