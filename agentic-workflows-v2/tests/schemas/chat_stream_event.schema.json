{
  "$defs": {
    "ChatDoneEvent": {
      "description": "Terminal frame: the reply for ``model`` completed normally.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "type": {
          "const": "done",
          "default": "done",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "ChatDoneEvent",
      "type": "object"
    },
    "ChatErrorEvent": {
      "description": "Terminal frame: the stream failed.\n\n``category`` is an :class:`agentic_v2.core.errors.ErrorCode` value\nderived via ``classify_error`` (e.g. ``auth_error``, ``rate_limited``).\n``message`` is scrubbed of bearer tokens and API keys server-side before\nit reaches the wire.",
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message",
        "category"
      ],
      "title": "ChatErrorEvent",
      "type": "object"
    },
    "ChatMediaEvent": {
      "description": "A safe image emitted by a multimodal model response.",
      "properties": {
        "alt": {
          "default": "Model-generated image",
          "maxLength": 300,
          "title": "Alt",
          "type": "string"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "type": {
          "const": "media",
          "default": "media",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "maxLength": 7100000,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "mime_type",
        "url"
      ],
      "title": "ChatMediaEvent",
      "type": "object"
    },
    "ChatRouteEvent": {
      "description": "Selected model for a tier-routed request, emitted before output tokens.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "requested_tier": {
          "maximum": 5,
          "minimum": 1,
          "title": "Requested Tier",
          "type": "integer"
        },
        "type": {
          "const": "route",
          "default": "route",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "requested_tier",
        "model"
      ],
      "title": "ChatRouteEvent",
      "type": "object"
    },
    "ChatTokenEvent": {
      "description": "Incremental text delta streamed from the model reply.",
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "string"
        },
        "type": {
          "const": "token",
          "default": "token",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "delta"
      ],
      "title": "ChatTokenEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "done": "#/$defs/ChatDoneEvent",
      "error": "#/$defs/ChatErrorEvent",
      "media": "#/$defs/ChatMediaEvent",
      "route": "#/$defs/ChatRouteEvent",
      "token": "#/$defs/ChatTokenEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ChatRouteEvent"
    },
    {
      "$ref": "#/$defs/ChatTokenEvent"
    },
    {
      "$ref": "#/$defs/ChatMediaEvent"
    },
    {
      "$ref": "#/$defs/ChatDoneEvent"
    },
    {
      "$ref": "#/$defs/ChatErrorEvent"
    }
  ]
}
