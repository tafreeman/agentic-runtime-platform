{
  "$defs": {
    "ChatDoneEvent": {
      "description": "Terminal frame: the reply for ``model`` completed normally.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "type": {
          "const": "done",
          "default": "done",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "ChatDoneEvent",
      "type": "object"
    },
    "ChatErrorEvent": {
      "description": "Terminal frame: the stream failed.\n\n``category`` is an :class:`agentic_v2.core.errors.ErrorCode` value\nderived via ``classify_error`` (e.g. ``auth_error``, ``rate_limited``).\n``message`` is scrubbed of bearer tokens and API keys server-side before\nit reaches the wire.",
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message",
        "category"
      ],
      "title": "ChatErrorEvent",
      "type": "object"
    },
    "ChatTokenEvent": {
      "description": "Incremental text delta streamed from the model reply.",
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "string"
        },
        "type": {
          "const": "token",
          "default": "token",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "delta"
      ],
      "title": "ChatTokenEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "done": "#/$defs/ChatDoneEvent",
      "error": "#/$defs/ChatErrorEvent",
      "token": "#/$defs/ChatTokenEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ChatTokenEvent"
    },
    {
      "$ref": "#/$defs/ChatDoneEvent"
    },
    {
      "$ref": "#/$defs/ChatErrorEvent"
    }
  ]
}
