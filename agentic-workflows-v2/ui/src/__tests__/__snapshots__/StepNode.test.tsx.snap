exports[`StepNode — per-theme DOM snapshots > renders identical DOM under data-theme='bolt' > theme=bolt 1`] = `"<div data-handlepos="top" data-id="1-null-null-target" class="react-flow__handle react-flow__handle-top nodrag nopan target connectable connectablestart connectableend connectionindicator" style="background: rgb(var(--b-blue)); width: 6px; height: 6px;"></div><div data-testid="dag-node-step-a" style="position: relative; width: 154px; background: rgb(var(--b-bg2)); border: var(--b-bw) solid rgb(var(--b-blue)); border-radius: var(--b-rad-sm); padding: 11px 13px; font-size: 10px; font-family: &quot;JetBrains Mono&quot;, &quot;Geist Mono&quot;, ui-monospace, monospace; box-sizing: border-box; opacity: 1; box-shadow: rgb(var(--b-blue) / 0.33) 0px 0px 10px;"><span aria-hidden="true" style="position: absolute; inset: -1px; border-radius: var(--b-rad-sm); border: 1px solid rgb(var(--b-blue)); pointer-events: none; animation: b-ring-pulse 1.5s ease-out infinite;"></span><div style="display: flex; justify-content: space-between; align-items: center;"><span data-testid="step-node-status" style="color: rgb(var(--b-blue)); font-size: 8.5px; letter-spacing: 1px;">[ •• ]</span><span data-testid="step-node-tier" style="font-size: 8.5px; letter-spacing: 0.3px; text-transform: uppercase; color: rgb(var(--b-blue)); border: 1px solid rgb(var(--b-blue)); padding: 0px 4px; border-radius: var(--b-rad-sm);">T1</span></div><div style="color: rgb(var(--b-text)); font-family: var(--b-font-heading); font-weight: 600; font-size: 12px; margin-top: 7px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="parse_code">parse_code</div><div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 9px; font-size: 9px; color: rgb(var(--b-text-faint)); font-family: &quot;JetBrains Mono&quot;, &quot;Geist Mono&quot;, ui-monospace, monospace;"><span>streaming</span><span data-testid="step-node-tokens" style="color: rgb(var(--b-text-mid));"><span>↓<span style="color: rgb(var(--b-text)); margin-left: 2px;">512</span></span><span style="margin-left: 4px;">↑<span style="color: rgb(var(--b-text)); margin-left: 2px;">312</span></span></span></div><div style="margin-top: 6px;"><div style="display: flex; justify-content: space-between; font-size: 9px; color: rgb(var(--b-text-dim));"></div><div data-testid="step-node-streaming-bar" style="margin-top: 2px; height: 2px; background: rgb(var(--b-bg3)); overflow: hidden;"><div style="width: 20%; height: 100%; background: rgb(var(--b-blue)); transition: width 0.08s linear;"></div></div></div></div><div data-handlepos="bottom" data-id="1-null-null-source" class="react-flow__handle react-flow__handle-bottom nodrag nopan source connectable connectablestart connectableend connectionindicator" style="background: rgb(var(--b-blue)); width: 6px; height: 6px;"></div>"`;

