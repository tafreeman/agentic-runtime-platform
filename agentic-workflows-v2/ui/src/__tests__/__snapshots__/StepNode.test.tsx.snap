// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StepNode — per-theme DOM snapshots > renders identical DOM under data-theme='bolt' > theme=bolt 1`] = `"<div data-handlepos="top" data-id="1-null-null-target" class="react-flow__handle react-flow__handle-top nodrag nopan target connectable connectablestart connectableend connectionindicator" style="background: rgb(var(--el-graph-running)); border: medium; width: 6px; height: 6px;"></div><div data-testid="dag-node-step-a" class="relative box-border rounded-md border px-[13px] py-[11px] font-mono text-micro text-el-graph-meta bg-el-graph-node ring-3 ring-el-graph-running-soft" style="width: 154px; border-color: rgb(var(--el-graph-running));"><span aria-hidden="true" data-testid="step-node-ring-pulse" class="el-ring-pulse pointer-events-none absolute -inset-px rounded-md border border-el-graph-running"></span><div class="flex items-center justify-between gap-1.5"><span data-testid="step-node-status" class="inline-flex min-w-0 items-center gap-1 font-sans font-medium text-el-graph-running"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dot size-3 flex-none" aria-hidden="true"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="12" r="10"></circle></svg><span class="truncate">Running</span></span><span data-testid="step-node-tier" title="Tier 1 — capability tier" class="inline-flex flex-none items-center rounded-sm border px-1 font-mono text-micro border-el-tier-low text-el-tier-low "><span aria-hidden="true">T1</span><span class="sr-only">Tier 1 — capability tier</span></span></div><div class="mt-[7px] truncate font-display text-xs font-semibold text-el-graph-label" title="parse_code">parse_code</div><div class="mt-[9px] flex items-baseline justify-end text-el-graph-meta"><span data-testid="step-node-tokens" class="text-el-graph-meta-strong"><span>↓<span class="ml-0.5 text-el-graph-label">512</span></span><span class="ml-1">↑<span class="ml-0.5 text-el-graph-label">312</span></span></span></div><div class="mt-1.5"><div class="flex justify-between text-el-graph-meta"></div><div data-testid="step-node-streaming-bar" class="mt-0.5 h-0.5 overflow-hidden bg-el-graph-progress-track"><div data-testid="step-node-streaming-fill" class="h-full w-full origin-left bg-el-graph-running el-stream-bar" style="transform: scaleX(0.6);"></div></div></div></div><div data-handlepos="bottom" data-id="1-null-null-source" class="react-flow__handle react-flow__handle-bottom nodrag nopan source connectable connectablestart connectableend connectionindicator" style="background: rgb(var(--el-graph-running)); border: medium; width: 6px; height: 6px;"></div>"`;

