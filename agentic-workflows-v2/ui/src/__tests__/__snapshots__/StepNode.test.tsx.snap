exports[`StepNode — per-theme DOM snapshots > renders identical DOM under data-theme='bolt' > theme=bolt 1`] = `"<div data-handlepos="top" data-id="1-null-null-target" class="react-flow__handle react-flow__handle-top nodrag nopan target connectable connectablestart connectableend connectionindicator" style="background: rgb(217, 119, 87); width: 6px; height: 6px;"></div><div data-testid="dag-node-step-a" style="width: 128px; background: rgb(8, 8, 12); border: 1px solid rgb(217, 119, 87); padding: 5px 8px; font-size: 10px; font-family: &quot;JetBrains Mono&quot;, &quot;Geist Mono&quot;, ui-monospace, monospace; box-sizing: border-box; box-shadow: rgba(217, 119, 87, 0.33) 0px 0px 10px;"><div style="display: flex; justify-content: space-between; align-items: center;"><span data-testid="step-node-status" style="color: rgb(var(--b-clay)); font-size: 8.5px; letter-spacing: 1px;">[RUN]</span><span data-testid="step-node-tier" style="font-size: 8.5px; letter-spacing: 0.3px; text-transform: uppercase; color: rgb(var(--b-purple)); border: 1px solid rgb(var(--b-purple)); padding: 0px 3px; border-radius: 1px;">T1</span></div><div style="color: rgb(236, 236, 222); font-weight: 600; font-size: 10.5px; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="parse_code">parse_code</div><div data-testid="step-node-tokens" style="margin-top: 4px; display: flex; justify-content: space-between; font-size: 9px; color: rgb(164, 164, 148); font-family: &quot;JetBrains Mono&quot;, &quot;Geist Mono&quot;, ui-monospace, monospace;"><span>↓<span style="color: rgb(236, 236, 222); margin-left: 2px;">512</span></span><span>↑<span style="color: rgb(236, 236, 222); margin-left: 2px;">312</span></span></div><div style="margin-top: 4px;"><div style="display: flex; justify-content: space-between; font-size: 9px; color: rgb(112, 112, 106);"><span style="color: rgb(217, 119, 87);">streaming</span></div><div data-testid="step-node-streaming-bar" style="margin-top: 2px; height: 2px; background: rgb(29, 29, 38); overflow: hidden;"><div style="width: 20%; height: 100%; background: rgb(217, 119, 87); transition: width 0.08s linear;"></div></div></div></div><div data-handlepos="bottom" data-id="1-null-null-source" class="react-flow__handle react-flow__handle-bottom nodrag nopan source connectable connectablestart connectableend connectionindicator" style="background: rgb(217, 119, 87); width: 6px; height: 6px;"></div>"`;

